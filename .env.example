# 환경변수 이름 목록입니다. 실제 값은 여기에 적지 않습니다.
# 값은 Vercel 환경변수와 GitHub Secrets에만 넣습니다.
# 내 컴퓨터에서 시험할 때만 이 파일을 .env.local로 복사해 값을 채웁니다 (.env.local은 저장소에 올라가지 않습니다).

# DB 접속 주소 (Supabase 프로젝트 설정에서 복사)
DATABASE_URL=

# 비밀값 암호화 키 (OTP 비밀키, 출처 API 키 보호용). 길이 32바이트 무작위 값을 base64로 만든 것
APP_ENC_KEY=

# 로그인 세션 서명 키. 길이 32바이트 이상 무작위 값
SESSION_SECRET=

# 최초 관리자 계정 (처음 한 번 만든 뒤에는 삭제)
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
